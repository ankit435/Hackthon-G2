# Copy to .env and fill in. .env is gitignored — never commit it.
# Read ONCE at the composition root (src/api) into a single settings object;
# services never read environment variables directly (PLAN.md §5).

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/audio_search
# Hugging Face token with access granted to BOTH gated repos:
#   pyannote/speaker-diarization-3.1  and  pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Models (locked stack, PLAN.md §17 — change only via a recorded decision)
WHISPER_MODEL=large-v3-turbo
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Fusion: weighted RRF (PLAN.md §7) --------------------------------------
# fused(chunk) = sum over branches b containing the chunk of weight_b / (k + rank_b)
# Equal weights are the permanent measured baseline. 0.0 disables a branch
# (diagnostic only; logs a WARNING). Negative/non-numeric values are rejected.
RRF_K=60
FUSION_WEIGHT_KEYWORD=1.0
FUSION_WEIGHT_SEMANTIC=1.0

# --- Retrieval ---------------------------------------------------------------
# Each branch fetches TOP_K * multiplier candidates; top-K is sliced only AFTER fusion.
# Default value is decided and recorded in Task 5 (PLAN.md §17 "still open").
CANDIDATE_DEPTH_MULTIPLIER=
# pgvector HNSW query-time recall/latency knob (pgvector default: 40).
HNSW_EF_SEARCH=40

# --- Chunking: semantic split of long turns (PLAN.md §6, Q12) ---------------
SPLIT_SOFT_MIN_SECONDS=20
SPLIT_CAP_SECONDS=45

# --- Logging (PLAN.md §9) ----------------------------------------------------
LOG_LEVEL=INFO
