# Copy to .env and fill in. .env is gitignored — never commit it.
# App settings use the AUDIO_SEARCH_ prefix. HF_TOKEN is unprefixed because huggingface_hub reads it by that name.
# Read ONCE at the composition root (src/api) into a single settings object;
# services never read environment variables directly (PLAN.md §5).

# --- Infrastructure --------------------------------------------------------
AUDIO_SEARCH_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/audio_search
# Hugging Face token with access granted to BOTH gated repos:
#   pyannote/speaker-diarization-3.1  and  pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Models (locked stack, PLAN.md §17 — change only via a recorded decision)
AUDIO_SEARCH_WHISPER_MODEL=large-v3-turbo
AUDIO_SEARCH_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
AUDIO_SEARCH_EMBEDDING_MODEL=BAAI/bge-m3
# cpu, mps (Apple Silicon) or cuda. First run downloads ~2.3 GB of weights; expect a slow start.
AUDIO_SEARCH_EMBEDDING_DEVICE=cpu
# Blank = Whisper auto-detects each file's language (one language per file). Set a Whisper
# language code (e.g. en, es, hi, zh) only to force every file to that language.
AUDIO_SEARCH_TRANSCRIPTION_LANGUAGE=

# --- Fusion: weighted RRF (PLAN.md §7) --------------------------------------
# fused(chunk) = sum over branches b containing the chunk of weight_b / (k + rank_b)
# Equal weights are the permanent measured baseline. 0.0 disables a branch
# (diagnostic only; logs a WARNING). Negative/non-numeric values are rejected.
AUDIO_SEARCH_RRF_K=60
AUDIO_SEARCH_FUSION_WEIGHT_KEYWORD=1.0
AUDIO_SEARCH_FUSION_WEIGHT_SEMANTIC=1.0

# --- Retrieval ---------------------------------------------------------------
# Each branch fetches TOP_K * multiplier candidates; top-K is sliced only AFTER fusion.
# 5 -> 50 candidates per branch at top_k=10 (~16% of the golden corpus). Decided in Task 5 from corpus size.
AUDIO_SEARCH_CANDIDATE_DEPTH_MULTIPLIER=5
# pgvector HNSW query-time recall/latency knob (pgvector default: 40).
AUDIO_SEARCH_HNSW_EF_SEARCH=40

# --- Cross-encoder re-ranking (PLAN.md §11 item 5, user-approved 2026-09-28) -
# Blank = OFF (the measured baseline). When set, /search re-scores the top
# RERANK_DEPTH fused candidates with this local cross-encoder, then cuts to top-K.
# Enable only after a before/after run of scripts/evaluate.py (recall up, p95 < 500 ms).
# Recommended: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 (multilingual, ~118M params)
AUDIO_SEARCH_RERANKER_MODEL=
AUDIO_SEARCH_RERANKER_DEVICE=cpu
AUDIO_SEARCH_RERANK_DEPTH=30

# --- Chunking: semantic split of long turns (PLAN.md §6, Q12) ---------------
AUDIO_SEARCH_SPLIT_SOFT_MIN_SECONDS=20
AUDIO_SEARCH_SPLIT_CAP_SECONDS=45
# Each chunk is EMBEDDED with its neighbours' words (nearest first, both sides evenly) up to this many
# tokens; stored text/timestamps stay the chunk's own. 0 = off (baseline). Re-ingest after changing.
AUDIO_SEARCH_CONTEXT_EMBEDDING_TOKENS=256

# --- Logging (PLAN.md §9) ----------------------------------------------------
AUDIO_SEARCH_LOG_LEVEL=INFO

# --- Optional NVIDIA-grounded answer endpoint --------------------------------
# POST /answer runs deterministic hybrid search first, then sends only numbered retrieved context to NVIDIA.
# It never changes the graded GET /search path. Keep this value secret.
NVIDIA_API_KEY=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUDIO_SEARCH_ANSWER_BASE_URL=https://integrate.api.nvidia.com/v1
AUDIO_SEARCH_ANSWER_MODEL=meta/muse-glimmer-30b

# --- Web UI uploads (POST /ingest/upload) -------------------------------------
# Browser uploads are written here (gitignored), then ingested by path.
AUDIO_SEARCH_UPLOAD_DIR=uploads
AUDIO_SEARCH_UPLOAD_MAX_MB=500
